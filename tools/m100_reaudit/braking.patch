+class _LocalPositionClock:
+    """Use advancing PX4 LOCAL_POSITION_NED time for elapsed flight time.
+
+    The position, velocity, and boot timestamp arrive in one MAVLink message.
+    Wall time supervises transport freshness even if other streams keep arriving.
+    """
+
+    STALL_TIMEOUT_S = 2.0  # Same wall-time freshness envelope as the MAVLink backend.
+
+    def __init__(self, sample: dict, phase: str):
+        self.phase = phase
+        self._stamp: float | None = None
+        self._progress_wall = time.monotonic()
+        self.start = self.read(sample)
+
+    def read(self, sample: dict) -> float:
+        stamp = sample.get("boot_time_s")
+        arrival = sample.get("last_local_position_monotonic")
+        now = time.monotonic()
+        if (not sample.get("fresh") or sample.get("local") is None or stamp is None
+                or not math.isfinite(stamp) or stamp < 0 or arrival is None
+                or not math.isfinite(arrival) or not 0 <= now - arrival < self.STALL_TIMEOUT_S):
+            raise RuntimeError(f"PX4 position telemetry unavailable {self.phase}")
+        if self._stamp is not None and stamp < self._stamp:
+            raise RuntimeError(f"PX4 position clock moved backward {self.phase}")
+        if self._stamp is None or stamp > self._stamp:
+            self._stamp = stamp
+            self._progress_wall = now
+        elif now - self._progress_wall >= self.STALL_TIMEOUT_S:
+            raise RuntimeError(f"PX4 position clock stalled {self.phase}")
+        return stamp
+
+
