+void GZBridge::publishM100LandState()
+{
+	const hrt_abstime now = hrt_absolute_time();
+	const unsigned previous_generation = _land_state_sub.get_last_generation();
+	const bool previous_landed = _land_state.landed;
+	const hrt_abstime previous_sample = _land_state.timestamp;
+	const bool updated = _land_state_sub.update(&_land_state);
+	_land_vehicle_status_sub.update(&_land_vehicle_status);
+
+	if (updated) {
+		if (!_land_transition_us || _land_state.timestamp < previous_sample) {
+			_land_sequence = 1;
+			_land_transition_us = _land_state.timestamp;
+
+		} else if (_land_state_sub.get_last_generation() - previous_generation != 1) {
+			// uORB overwrote an observation. A consumer cannot establish an
+			// uninterrupted airborne episode across this discontinuity.
+			_land_sequence += 2;
+			_land_transition_us = _land_state.timestamp;
+
+		} else if (_land_state.landed != previous_landed) {
+			++_land_sequence;
+			_land_transition_us = _land_state.timestamp;
+		}
+	}
+
+	// The detector publishes on changes and at least once per second. Repeat
+	// its original timestamp so delayed subscribers can recover an exact edge.
+	if (!_land_transition_us || now < _land_state.timestamp || now - _land_state.timestamp > 2_s
+	    || (!updated && now >= _last_land_send_us && now - _last_land_send_us < 200_ms)) {
+		return;
+	}
+
+	const bool arm_known = _land_vehicle_status.timestamp && _land_vehicle_status.timestamp <= now
+			       && now - _land_vehicle_status.timestamp < 2_s;
+	const char *armed = arm_known ? (_land_vehicle_status.arming_state == vehicle_status_s::ARMING_STATE_ARMED ? "true" : "false") : "null";
+	gz::msgs::StringMsg message;
+	message.set_data("{\"model\":\"" + _model_name + "\",\"time_s\":" + std::to_string(_land_state.timestamp * 1e-6)
+			 + ",\"transition_s\":" + std::to_string(_land_transition_us * 1e-6)
+			 + ",\"sequence\":" + std::to_string(_land_sequence) + ",\"landed\":" + (_land_state.landed ? "true" : "false")
+			 + ",\"armed\":" + armed + "}");
+	_m100_land_publisher.Publish(message);
+	_last_land_send_us = now;
+}
