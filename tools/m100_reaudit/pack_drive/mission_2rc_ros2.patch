+def cross_track_error_m(pos, leg):
+    """Horizontal distance to the active finite leg in takeoff-relative ENU."""
+    if leg is None:
+        return abs(float(pos[1]))  # Legacy eastbound measurement protocol.
+    (x0, y0), (x1, y1) = leg
+    dx, dy = x1-x0, y1-y0
+    length_sq = dx*dx + dy*dy
+    if length_sq == 0:
+        return math.hypot(pos[0]-x0, pos[1]-y0)
+    fraction = min(1., max(0., ((pos[0]-x0)*dx + (pos[1]-y0)*dy) / length_sq))
+    return math.hypot(pos[0]-x0-fraction*dx, pos[1]-y0-fraction*dy)
+
