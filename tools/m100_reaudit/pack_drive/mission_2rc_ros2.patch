+                "observed_east_m": local["y"]-home[1], "observed_north_m": local["x"]-home[0],
+                "observed_agl_m": home[2]-local["z"],
+                "horizontal_speed_mps": math.hypot(local["vx"], local["vy"])})
+            previous = (east, north)
+            completed_length += length
+        self._mission_leg_enu = (previous, (0.0, 0.0))
+        self._freeze_measurement(self._measurement_distance_m)
