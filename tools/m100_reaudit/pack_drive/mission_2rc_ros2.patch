+    def _delivery_waypoints(self, distance):
+        # East/north metres relative to the takeoff point. All alternatives
+        # visit the same destination and use the existing direct return.
+        if self._mission_route == "direct":
+            return [(distance, 0.0)]
+        sign = 1 if self._mission_route == "north_dogleg" else -1
+        return [(distance / 2, sign * distance / 4), (distance, 0.0)]
+
+    def _route_metadata(self, config):
+        if self._mission_route == "measurement" or config.cruise_speed_mps == 0:
+            return {}
+        points = self._delivery_waypoints(config.route_length_m)
+        path_m = sum(math.dist(a, b) for a, b in zip([(0., 0.)] + points, points))
+        return dict(route_definition="FIXED_DESTINATION_FROM_TAKEOFF", mission_route_id=self._mission_route,
+                    planned_destination_east_m=config.route_length_m, planned_destination_north_m=0.,
+                    planned_waypoints_enu_m=points, planned_outbound_path_m=path_m)
+
+    def _fly_fixed_destination(self, config, home, target_down, yaw):
+        self._begin_measurement(True)
+        previous = (0.0, 0.0)
+        completed_length = 0.0
+        for east, north in self._delivery_waypoints(config.route_length_m):
+            self._mission_leg_enu = (previous, (east, north))
+            length = math.hypot(east - previous[0], north - previous[1])
+            target = (home[0] + north, home[1] + east, home[2])
+            def observe(local, error, speed, target_speed):
+                dx, dy = east - previous[0], north - previous[1]
+                projected = ((local["y"] - home[1] - previous[0]) * dx +
+                             (local["x"] - home[0] - previous[1]) * dy) / length
+                self._measurement_distance_m = completed_length + min(length, max(0.0, projected))
+                if error <= M100_RETURN_CAPTURE_RADIUS_M and speed < 0.3:
+                    phase = "HOVER"
+                elif target_speed < 0.95 * config.cruise_speed_mps:
+                    phase = "RETURN_BRAKING"
+                elif speed < 0.95 * config.cruise_speed_mps:
+                    phase = "STABILIZING"
+                else:
+                    phase = "CRUISE"
+                if phase != self._state:
+                    self._set_state(phase, f"Waypoint east {east:g} m, north {north:g} m")
+            local = self._center_over_home_at_limited_speed(
+                target, target_down, yaw, config.cruise_speed_mps,
+                55 + 4 * length / config.cruise_speed_mps, observe=observe)
+            self._route_checkpoints.append({
