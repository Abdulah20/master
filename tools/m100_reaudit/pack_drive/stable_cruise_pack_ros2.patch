@@ -0,0 +1,109 @@
+"""Exercise joint callback -> ROS pack demand with both battery treatments."""
+
+import json
+import time
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+from sensor_msgs.msg import JointState
+
+from drone_nav import m100_experiment_manager as runtime
+from drone_nav.m100_atmosphere import compare_density_to_15c_reference, dry_air_state
+from drone_nav.m100_contract import build_config
+from drone_nav.m100_stable_cruise_speed import MODEL_ID
+
+
+@pytest.fixture(scope="module")
+def fits():
+    return (runtime.PublishedEnergyConfig.load(runtime.ENERGY_CONFIG),
+            runtime.StableCruiseSpeedFit.load(runtime.STABLE_CRUISE_ENERGY_CONFIG))
+
+
+def request_for(fits, *, speed=6, enabled=True, phase="CRUISE", measuring=True,
+                local_fresh=True, armed=True, recovering=False, length=200, wind=0, valid_joints=True):
+    manager = object.__new__(runtime.M100ExperimentManager)
+    manager._energy_config, manager._stable_cruise_fit = fits
+    manager._energy_model = runtime.M100PublishedEnergyModel(manager._energy_config)
+    manager._config = build_config(temperature_c=15, payload_kg=0.25, wind_speed_mps=wind,
+                                   wind_direction_deg=0, cruise_speed_mps=speed, altitude_m=50,
+                                   route_length_m=length, hover_duration_s=15)
+    manager._applied_atmosphere = compare_density_to_15c_reference(15, 50)
+    manager._active_payload = manager._config.payload
+    manager._active_runtime_model = manager._active_payload.model
+    manager._pack_stable_cruise_enabled = enabled
+    manager._state, manager._measurement_active, manager._recovering_landing = phase, measuring, recovering
+    manager._recording = False
+    manager._home_ned = (0., 0., 0.)
+    manager._power_position_stamp = (None, 0.)
+    manager._distance_m = 0.
+    now = time.monotonic()
+    manager._clock_advanced_at = now
+    manager._gazebo_sim_time_s, manager._pack_epoch_s = 42., None
+    manager._pack_requests, manager._pack_signal_times = [], {}
+    manager._pack_drive_pub = Mock()
+    manager._transient_power = Mock()
+    manager._transient_power.estimate.return_value = None
+    manager._wind_simulation = Mock()
+    manager._wind_simulation.power_delta_w.return_value = None
+    manager._runtime_energy = Mock()
+    manager._runtime_energy.optional_wind_power_delta.return_value = None
+    manager._propulsion = SimpleNamespace(thrust_constant_n_per_rad_s2=1e-5, yaw_moment_ratio_m=0.02)
+    # Local altitude differs from configured altitude to expose manager-power substitution.
+    local = dict(x=0., y=100., z=-48., vx=0., vy=float(speed), vz=0.)
+    manager._mav = Mock()
+    manager._mav.snapshot.return_value = dict(local=local, boot_time_s=42., fresh=local_fresh,
+        armed=armed, landed=not armed, heartbeat_fresh=True, landed_state_known=True,
+        last_heartbeat_monotonic=now, last_landed_state_monotonic=now, last_local_position_monotonic=now)
+    message = JointState()
+    message.header.stamp.sec = 42
+    message.name = list(runtime.ROTOR_JOINT_NAMES)
+    message.velocity = [60., -60., 60., -60.] if valid_joints else []
+    manager._process_rotor_joint_state(message)
+    request = json.loads(manager._pack_drive_pub.publish.call_args.args[0].data)
+    assert request == manager._pack_requests[-1]
+    return request
+
+
+@pytest.mark.parametrize("enabled", (False, True))
+@pytest.mark.parametrize("local_fresh", (False, True))
+@pytest.mark.parametrize("speed", (4, 6, 8))
+def test_eligible_residual_enters_both_native_paths_once(fits, speed, enabled, local_fresh):
+    request = request_for(fits, speed=speed, enabled=enabled, local_fresh=local_fresh)
+    power, fit = fits
+    base = power.estimate_power("CRUISE", 0.25, dry_air_state(15, 50).density_kg_m3).power_w
+    delta = fit.offset_w + fit.slope_w_per_mps * (speed - fit.reference_speed_mps)
+    proposed = base + (delta if enabled else 0.)
+    assert request["stable_cruise_speed_enabled"] is enabled
+    assert request["stable_cruise_speed_eligible_adjustment_w"] == delta
+    assert request["stable_cruise_speed_adjustment_w"] == (delta if enabled else None)
+    assert request["stable_cruise_speed_model_id"] == (MODEL_ID if enabled else None)
+    assert request["phase_source"] == power.model_id
+    assert request["phase_base_power_w"] == pytest.approx(base)
+    assert request["phase_power_w"] == pytest.approx(proposed)
+    if local_fresh:
+        assert request["power_w"] == pytest.approx(proposed)
+        local_base = power.estimate_power("CRUISE", 0.25, dry_air_state(15, 48).density_kg_m3).power_w
+        assert request["manager_power_w"] == pytest.approx(local_base + delta)
+    else:
+        assert request["power_w"] is None and request["manager_power_w"] is None
+
+
+@pytest.mark.parametrize("case", [
+    *({"speed": speed} for speed in (0, 5, 10, 15, 20)), {"phase": "STABILIZING"},
+    {"phase": "RETURN_BRAKING"}, {"phase": "RETURNING"}, {"phase": "LANDING"},
+    {"recovering": True}, {"measuring": False}, {"speed": 8, "length": 150},
+    {"wind": 3}, {"valid_joints": False},
+])
+def test_no_native_speed_residual_outside_original_gate(fits, case):
+    request = request_for(fits, **case)
+    assert request["phase_power_w"] == request["phase_base_power_w"]
+    assert request["stable_cruise_speed_eligible_adjustment_w"] is None
+    assert request["stable_cruise_speed_adjustment_w"] is None
+    assert request["stable_cruise_speed_model_id"] is None
+
+
+def test_disarmed_zero_keeps_authority_over_an_eligible_proposal(fits):
+    request = request_for(fits, armed=False)
+    assert request["power_w"] == 0 and request["source"] == "DRIVE_DISARMED"
+    assert request["phase_power_w"] < request["phase_base_power_w"]
